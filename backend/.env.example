DATABASE_URL=postgres://postgres:postgres@localhost:5432/approval_portal
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=3000

# Encryption key for sensitive data (VM passwords)
# If not set, JWT_SECRET is used as fallback
ENCRYPTION_SECRET=your-encryption-secret-change-in-production

# CORS allowed origins (comma-separated)
# Use * to allow all origins (not recommended for production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# vSphere Configuration
VSPHERE_SERVER=vcenter.example.com
VSPHERE_USER=administrator@vsphere.local
VSPHERE_PASSWORD=your-vsphere-password
VSPHERE_ALLOW_UNVERIFIED_SSL=true
VSPHERE_DATACENTER=Datacenter
VSPHERE_CLUSTER=Cluster
VSPHERE_DATASTORE=datastore1
VSPHERE_NETWORK=VM Network
VSPHERE_TEMPLATE_FOLDER=Templates
VSPHERE_VM_FOLDER=VMs

# Template mappings (OS type -> template name)
VSPHERE_TEMPLATE_UBUNTU_22_04=ubuntu-22.04-template
VSPHERE_TEMPLATE_UBUNTU_20_04=ubuntu-20.04-template
VSPHERE_TEMPLATE_DEBIAN_12=debian-12-template
VSPHERE_TEMPLATE_CENTOS_9=centos-stream-9-template
VSPHERE_TEMPLATE_RHEL_9=rhel-9-template
VSPHERE_TEMPLATE_WINDOWS_2022=windows-server-2022-template
VSPHERE_TEMPLATE_WINDOWS_2019=windows-server-2019-template

# Terraform workspace directory
TERRAFORM_WORKSPACE_DIR=./terraform-workspaces
